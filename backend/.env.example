# Backend environment template for the confirmed Railway deployment.
# Keep this file free of credentials and set values in Railway's environment UI.
MEV_CORS_ORIGINS=https://revacc.vercel.app

# Railway supplies PORT automatically. Local development may use the existing
# start.sh wildcard override instead of copying this production origin.

# Step 4-3 uses validated PDB text fetched by step 4-2 and performs an
# explicitly local coordinate-contact analysis; it is not official ERRAT.
# explicitly labeled as an AlphaFold DB alternate, never as SWISS-MODEL.
MEV_STRUCTURE_PROVIDER=alphafold_db

# SWISS-MODEL is only attempted when explicitly selected and requires an
# official authenticated client. Keep credentials in Railway secrets only;
# never commit a token here.
# SWISSMODEL_API_TOKEN=
