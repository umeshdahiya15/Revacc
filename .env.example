# ============================================================================
# Revacc Pipeline - Environment Configuration
# Copy this file to .env and modify as needed
# ============================================================================

# Pipeline Speed (milliseconds between steps)
# Lower = faster, but more CPU usage
MEV_STEP_TICK_MS=650

# CORS Origins (comma-separated list of allowed origins)
# Use * for development, specify domains for production
MEV_CORS_ORIGINS=*

# Database (optional - for future use)
# POSTGRES_USER=mev
# POSTGRES_PASSWORD=mev
# POSTGRES_DB=mev

# External API emails (optional - for NCBI/IEDB rate limiting)
# EBI_EMAIL=your-email@example.com
# NCBI_EMAIL=your-email@example.com
